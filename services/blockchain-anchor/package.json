    "test": "vitest run",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@polkadot/api": "^14.3.1",
    "@scp/contracts": "workspace:*",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.3"
  }
}
