NODE_ENV=development
LOG_LEVEL=info

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sensors-connectivity

REDIS_URL=redis://localhost:6379
IPFS_API_URL=http://localhost:5001
SUBSTRATE_WS_URL=ws://localhost:9944

AUTHORIZER_PORT=3000
AUTHORIZER_SOURCE=authorizer
AUTHORIZER_TIMESTAMP_SKEW_SECONDS=300
AUTHORIZER_PRODUCER_MAX_ATTEMPTS=3
AUTHORIZER_PRODUCER_RETRY_BACKOFF_MS=100
PUBSUB_TOPIC=telemetry/authorized/v1
BLOCKCHAIN_TARGET=robonomics-dev
